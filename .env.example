NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Solo para scripts/importar-negocios.mjs (herramienta manual, no la app)
GOOGLE_PLACES_API_KEY=tu-api-key-de-google-places
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Sincronización nocturna de agendas (/api/cron/sync-events).
# Vercel Cron manda este valor en la cabecera Authorization: Bearer <...>.
CRON_SECRET=una-cadena-larga-y-aleatoria

# Correos transaccionales (aviso al dueño cuando se aprueba o rechaza su
# solicitud de negocio). Sin RESEND_API_KEY no se envía nada y se deja
# un aviso en el log; la app sigue funcionando.
RESEND_API_KEY=re_xxx
# Remitente verificado en Resend. Con onboarding@resend.dev solo llega a
# la cuenta dueña de la API key (vale para probar).
EMAIL_FROM="Jaén Guía <hola@tu-dominio.com>"

# Buzón de WhatsApp (/api/whatsapp/webhook): los dueños reenvían el
# cartel de su evento y Claude lo convierte en un borrador del panel.
# Se configura en developers.facebook.com → app → WhatsApp.
WHATSAPP_VERIFY_TOKEN=cadena-que-pegas-al-registrar-el-webhook
WHATSAPP_APP_SECRET=app-secret-de-la-app-de-meta
WHATSAPP_ACCESS_TOKEN=token-de-sistema-permanente
WHATSAPP_PHONE_NUMBER_ID=id-numerico-del-numero
# Número visible en el panel para que el dueño sepa a dónde mandar
# el cartel. Formato internacional sin "+" (se muestra con él).
NEXT_PUBLIC_WHATSAPP_NUMERO=34600111222

# Lectura de carteles vía OpenRouter (src/lib/extraccion-evento.ts).
# Clave en openrouter.ai/keys. El modelo se puede cambiar sin tocar
# código; por defecto anthropic/claude-sonnet-5.
# Cualquier API compatible con OpenAI (chat/completions) con visión.
# Por defecto OpenRouter + Claude Sonnet 5 (~5 $/mes). Gratis: Groq.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELO=anthropic/claude-opus-5
# Groq free tier (1.000 tokens de salida/min; el código espera y reintenta):
# OPENROUTER_URL=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_API_KEY=gsk_...
# OPENROUTER_MODELO=qwen/qwen3.8-27b

# Página de Facebook / Instagram conectada (/panel/[slug] → "Conectar
# Facebook"). App en developers.facebook.com con Facebook Login for
# Business; el App Secret también cifra los tokens guardados.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Lectura de redes públicas sin permiso del negocio (/api/cron/sync-publico).
# Instagram: Business Discovery con la cuenta @jaenguia (tipo Business,
# vinculada a la página de Facebook de Jaén Guía). Token de página con
# instagram_basic, instagram_manage_insights y pages_read_engagement.
INSTAGRAM_JG_USER_ID=
INSTAGRAM_JG_TOKEN=
# Facebook: scraper de Apify (apify/facebook-posts-scraper).
APIFY_TOKEN=
# Publicar directamente lo que Claude lee con confianza alta (1) o dejar
# todo en borrador para el admin (vacío, por defecto).
BUZON_AUTOPUBLICAR=

# Pagos con Stripe (src/lib/stripe.ts, /api/webhooks/stripe). Claves de
# test (sk_test_…) hasta salir a producción. Los price_… se crean en
# el panel de Stripe: evento promocionado 5 € (único) y plan Destacado
# 19 €/mes (recurrente).
STRIPE_SECRET_KEY=sk_test_...
# Clave pública (pk_test_…): la usa el Checkout incrustado en el navegador.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_EVENTO_PROMOCIONADO=price_...
STRIPE_PRICE_DESTACADO=price_...
# Lo da `stripe listen` en local o el endpoint del webhook en el panel.
STRIPE_WEBHOOK_SECRET=whsec_...
